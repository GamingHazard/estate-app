{
  "expo": {
    "name": "Property Fit",
    "slug": "property-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ic_launcher.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/ic_launcher.png",
      "backgroundColor": "#FFFFFF",
      "imageWidth": 200,
      "resizeMode": "contain",
      "dark": {
        "image": "./assets/ic_launcher.png",
        "backgroundColor": "#1F2937"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic_launcher_foreground.png",
        "backgroundColor": "#1F2937"
      },
      "package": "com.gost150.newestateapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d15af840-f365-4e50-9d0b-4e681836e954"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-web-browser"
    ]
  }
}
